{
  "resources": [
    {
      "path": "Makefile",
      "type": "makefile",
      "params": {
        "variable": "version"
      }
    },
    {
      "path": "dkms.conf",
      "type": "text",
      "params": {
        "regex": "(?<=PACKAGE_VERSION=\")[^\"]+(?=\")"
      }
    },
    {
      "path": "CHANGELOG.md",
      "type": "keep-a-changelog"
    },
    {
      "path": "debian/changelog",
      "type": "text",
      "params": {
        "regex": "(?<=^usbled-standalone-dkms \\()[^)]+(?=-\\d+\\))"
      }
    }
  ]
}